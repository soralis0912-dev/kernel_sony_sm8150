&qupv3_se4_i2c {
	nfc@28 {
		compatible = "nxp,pn553";
		reg = <0x28>;
		interrupt-parent = <&tlmm>;
		interrupts = <47 0x1>;
		nxp,irq_gpio = <&tlmm 47 0x00>;
		nxp,dwld_en = <&tlmm 48 0x00>;
		nxp,ven = <&tlmm 41 0x01>;
		nxp,ese-pwr = <&tlmm 42 0x00>;
	};
};

&soc {
	nfc,pm-ops {
		compatible = "sony,pn553-pm-ops";
	};

	/* SPI: QUP0 */
	spi@880000 {
		/*
		 * Stock overrides the compatible with "qcom,spi-geni-cloned",
		 * which the geni driver in this tree does not match - not
		 * something the upstream merge dropped, it has never been
		 * here.  The controller then never binds, so no SPI master is
		 * created and the p61 child below is never registered, which
		 * is what /dev/p73 is made from.  Nothing else uses SE0, so
		 * there is nothing to clone it away from; leave the base
		 * compatible alone.
		 */
		pinctrl-0 = <&sm_gpio_0 &sm_gpio_1 &sm_gpio_2>;
		pinctrl-1 = <&sm_gpio_0_sleep &sm_gpio_1 &sm_gpio_2>;
		nxp,ese-pwr = <&tlmm 42 0x00>;
		nxp,ese-cs = <&tlmm 3 0x00>;
		status = "okay";

		dev@0 {
			compatible = "nxp,p61";
			reg = <0>;
			spi-max-frequency = <30000000>;
		};
	};
};

&tlmm {
	sm_gpio_0_sleep: sm_gpio_0_sleep {
		mux {
			pins = "gpio0";
			function = "gpio";
		};

		config {
			pins = "gpio0";
			drive-strength = <2>;
			output-low;
		};
	};
};
